@host = http://localhost:5985
@auth = Basic admin:{{$dotenv COUCHDB_PASSWORD}}


### ============================================================
### TEST 09 - OPERACIONES ADICIONALES
### Ejecutar después de los tests 02 y 06.
### Ejecutar las peticiones de creación una sola vez por base de datos.
### ============================================================


### 0. VERIFICAR SI LOS DOCUMENTOS YA EXISTEN
### Antes de crear los datos, los documentos de este test deberían
### aparecer como not_found. Si ya existen, no vuelvas a ejecutar
### los PUT de creación en esa misma base de datos.

POST {{host}}/mercapos/_all_docs?include_docs=true
Authorization: {{auth}}
Content-Type: application/json

{
  "keys": [
    "operacion:disp03:20261021T090000",
    "mov:disp03:20261021T090000:r1:0042",
    "operacion:disp03:20261022T170000",
    "mov:disp03:20261022T170000:r1:0042",
    "operacion:disp03:20261023T110000",
    "mov:disp03:20261023T110000:r1:0042",
    "conteo:disp03:20261024T180000",
    "operacion:disp03:20261024T180500",
    "mov:disp03:20261024T180500:r1:0042"
  ]
}


### ============================================================
### 1. COMPRA: ENTRADA DE 20 LIBRAS DE TOMATE + SU MOVIMIENTO
### ============================================================

PUT {{host}}/mercapos/operacion:disp03:20261021T090000
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "operacion",
  "tipo_operacion": "compra",
  "puesto_id": "puesto:0001",
  "usuario_id": "usuario:0002",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-21T09:00:00-06:00",
  "renglones": [
    {
      "producto_id": "producto:0042",
      "cantidad": 20,
      "costo_unitario": 0.90
    }
  ],
  "total": 18.00
}

### Movimiento de la compra (+20)
PUT {{host}}/mercapos/mov:disp03:20261021T090000:r1:0042
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "movimiento",
  "puesto_id": "puesto:0001",
  "producto_id": "producto:0042",
  "cantidad": 20,
  "motivo": "compra",
  "operacion_id": "operacion:disp03:20261021T090000",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-21T09:00:00-06:00"
}


### ============================================================
### 2. MERMA: 2 LIBRAS DE TOMATE EN MAL ESTADO + SU MOVIMIENTO
### ============================================================

PUT {{host}}/mercapos/operacion:disp03:20261022T170000
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "operacion",
  "tipo_operacion": "merma",
  "puesto_id": "puesto:0001",
  "usuario_id": "usuario:0001",
  "dispositivo_id": "disp03",
