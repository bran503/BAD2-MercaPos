    {
      "producto_id": "producto:0042",
      "cantidad": 2
    }
  ],
  "motivo": "producto en mal estado"
}

### Movimiento de merma (-2)
PUT {{host}}/mercapos/mov:disp03:20261022T170000:r1:0042
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "movimiento",
  "puesto_id": "puesto:0001",
  "producto_id": "producto:0042",
  "cantidad": -2,
  "motivo": "merma",
  "operacion_id": "operacion:disp03:20261022T170000",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-22T17:00:00-06:00"
}


