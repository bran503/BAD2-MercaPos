  "cantidad": 1,
  "motivo": "devolucion",
  "operacion_id": "operacion:disp03:20261023T110000",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-23T11:00:00-06:00"
}


### ============================================================
### 4. CONTEO FÍSICO
### El sistema indica 64 libras y se cuentan 63.
### Diferencia = 63 - 64 = -1.
### ============================================================

PUT {{host}}/mercapos/conteo:disp03:20261024T180000
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "conteo_fisico",
  "puesto_id": "puesto:0001",
  "usuario_id": "usuario:0002",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-24T18:00:00-06:00",
  "renglones": [
    {
      "producto_id": "producto:0042",
      "cantidad_sistema": 64,
      "cantidad_contada": 63,
      "diferencia": -1
    }
  ]
}


### ============================================================
### 5. AJUSTE DERIVADO DEL CONTEO + SU MOVIMIENTO
### ============================================================

PUT {{host}}/mercapos/operacion:disp03:20261024T180500
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "operacion",
  "tipo_operacion": "ajuste",
  "puesto_id": "puesto:0001",
  "usuario_id": "usuario:0002",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-24T18:05:00-06:00",
  "renglones": [
    {
      "producto_id": "producto:0042",
      "cantidad": -1
    }
  ],
  "motivo": "diferencia detectada en conteo físico",
  "conteo_id": "conteo:disp03:20261024T180000"
}

### Movimiento del ajuste (-1)
PUT {{host}}/mercapos/mov:disp03:20261024T180500:r1:0042
Authorization: {{auth}}
Content-Type: application/json

{
  "tipo": "movimiento",
  "puesto_id": "puesto:0001",
  "producto_id": "producto:0042",
  "cantidad": -1,
  "motivo": "ajuste",
  "operacion_id": "operacion:disp03:20261024T180500",
  "dispositivo_id": "disp03",
  "fecha_local": "2026-10-24T18:05:00-06:00"
}


### ============================================================
### 6. COMPROBAR EXISTENCIAS FINALES
### Esperado después de los tests 02, 06 y 09:
### tomate (producto:0042) = 63; cebolla (producto:0107) = 29.
### Cálculo del tomate antes del ajuste: 50 - 2 + 20 - 2 + 1 - 3 = 64.
### Después del ajuste de -1: 63.
### ============================================================

GET {{host}}/mercapos/_design/inventario/_view/existencias?group=true
Authorization: {{auth}}


### ============================================================
### 7. COMPROBAR LOS NUEVE DOCUMENTOS DE ESTE TEST
### Esta consulta sirve tanto para revisar que fueron creados
### como para comprobar los campos de los movimientos.
### ============================================================

POST {{host}}/mercapos/_all_docs?include_docs=true
Authorization: {{auth}}
Content-Type: application/json

{
  "keys": [
    "operacion:disp03:20261021T090000",
    "mov:disp03:20261021T090000:r1:0042",
    "operacion:disp03:20261022T170000",
    "mov:disp03:20261022T170000:r1:0042",
    "operacion:disp03:20261023T110000",
    "mov:disp03:20261023T110000:r1:0042",
    "conteo:disp03:20261024T180000",
    "operacion:disp03:20261024T180500",
    "mov:disp03:20261024T180500:r1:0042"
  ]
}


### ============================================================
### 8. COMPROBAR EL MOVIMIENTO DEL AJUSTE
### Esperado: puesto_id = puesto:0001 y cantidad = -1.
### ============================================================

GET {{host}}/mercapos/mov:disp03:20261024T180500:r1:0042
Authorization: {{auth}}
