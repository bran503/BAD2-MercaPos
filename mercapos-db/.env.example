# Copie a .env y elija una contraseña local privada.
COUCHDB_PASSWORD=REEMPLAZAR_CON_CLAVE_LOCAL

# Cuenta de servicio para la API. No reutilice la clave de admin.
API_COUCHDB_USERNAME=mercapos_api
API_COUCHDB_PASSWORD=REEMPLAZAR_CON_OTRA_CLAVE_LOCAL
COUCHDB_ADMIN_USERNAME=admin
COUCHDB_ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_LOCAL
COUCHDB_DATABASE=mercapos
COUCHDB_AUTH_DATABASE=mercapos_auth
